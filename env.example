# Environment Variables for FLUX Gold Tracker

# NewsAPI Key - Get your free key at https://newsapi.org/
NEWS_API_KEY=your_newsapi_key_here

# Metals.dev API Key - Get your free key at https://metals.dev/
METALS_DEV_API_KEY=your_metals_dev_api_key_here

# --- Private dashboard access (protects /dashboard from the public) ---

# Password required to sign in at /login.html. Choose your own value.
DASHBOARD_PASSWORD=choose_a_strong_password

# Random secret used to sign the login session cookie. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=replace_with_a_long_random_string

# Instructions:
# 1. Copy this file to .env.local for local development
# 2. Replace the placeholder values with your actual API keys
# 3. Add these same variables to your Vercel project settings:
#    Dashboard → Project → Settings → Environment Variables
# 4. NEVER commit .env or .env.local to Git!
